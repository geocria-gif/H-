# SISPM - Environment Variables Example
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_CONFIG=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars

# Database Configuration
# Development (SQLite)
DEV_DATABASE_URL=sqlite:///instance/sispm_dev.db

# Firebase (service account JSON path - secret, never commit the file)
# Baixe em: Firebase Console > Config. do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_PROJECT_ID=gestoper-4ba86

# Production (PostgreSQL)
DATABASE_URL=postgresql://sispm:sispm@localhost:5432/sispm
POSTGRES_DB=sispm
POSTGRES_USER=sispm
POSTGRES_PASSWORD=sispm

# Redis Configuration (for caching/rate limiting)
REDIS_URL=redis://localhost:6379/0

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Security
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
JWT_COOKIE_SECURE=False

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Backup
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Email (for password recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=SISPM <noreply@sispm.com>

# Cache
CACHE_TYPE=RedisCache
CACHE_REDIS_URL=redis://localhost:6379/0

# Instagram (Meta Graph API) - veja INSTAGRAM_API.md
INSTAGRAM_ACCESS_TOKEN=cole_o_access_token_aqui
INSTAGRAM_IG_USER_ID=cole_o_instagram_business_account_id
INSTAGRAM_APP_ID=id_do_app_meta
INSTAGRAM_APP_SECRET=segredo_do_app_meta
INSTAGRAM_API_VERSION=v21.0
PUBLIC_BASE_URL=http://localhost:5000

# Gunicorn
GUNICORN_WORKERS=4

# StatsD (optional)
STATSD_HOST=localhost:8125