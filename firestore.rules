rules_version = '2';
// GestOper CPR-CN — Firestore Security Rules
// Leitura e escrita exige usuário autenticado no Firebase Authentication.
// Como instalar:
//   1) Firebase Console -> projeto gestoper-4ba86 -> Firestore Database -> Regras
//   2) Substitua o conteúdo pelas regras abaixo e publique.
//   3) Crie ao menos um usuario em Authentication -> Users (email + senha).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}